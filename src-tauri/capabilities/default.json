{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for Who Am I: draw our own window chrome (drag, minimize, maximize, close), read/write the record under $HOME, run the derived SQLite index, read another app's local DB read-only for history import (e.g. Warp under a mounted Windows drive on WSL), shell out to git for Sync, and pick a folder.",
  "windows": ["main"],
  "permissions": [
    "core:default",

    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",

    "dialog:default",
    "dialog:allow-open",

    "shell:allow-execute",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "git", "cmd": "git", "args": true }]
    },
    "shell:allow-open",

    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",

    "fs:default",
    { "identifier": "fs:allow-read-text-file", "allow": [{ "path": "$HOME/**" }] },
    { "identifier": "fs:allow-read-file", "allow": [{ "path": "$HOME/**" }] },
    { "identifier": "fs:allow-write-text-file", "allow": [{ "path": "$HOME/**" }] },
    { "identifier": "fs:allow-mkdir", "allow": [{ "path": "$HOME/**" }] },
    { "identifier": "fs:allow-remove", "allow": [{ "path": "$HOME/**" }] },
    { "identifier": "fs:allow-read-dir", "allow": [{ "path": "$HOME/**" }, { "path": "/mnt/*/Users" }] },
    { "identifier": "fs:allow-exists", "allow": [{ "path": "$HOME/**" }, { "path": "/mnt/*" }, { "path": "/mnt/*/Users" }, { "path": "/mnt/*/Users/**" }] },

    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "https://api.anthropic.com/*" },
        { "url": "https://api.github.com/*" },
        { "url": "https://app.asana.com/*" },
        { "url": "https://gmail.googleapis.com/*" },
        { "url": "http://localhost:*/*" },
        { "url": "http://127.0.0.1:*/*" }
      ]
    }
  ]
}
